CI_ENVIRONMENT = production

app.baseURL = 'https://tu-dominio.com/'
app.cookieDomain = 'tu-dominio.com'
app.encryption_key = 'cambia-esta-clave'

database.default.hostname = 'localhost'
database.default.username = 'usuario_bd'
database.default.password = 'clave_bd'
database.default.database = 'nombre_bd'
database.default.DBPrefix = 'rise_'
database.default.port = 3306
database.default.DBDebug = false

email.fromEmail = ''
email.fromName = ''
email.recipients = ''
email.protocol = 'mail'
email.mailPath = '/usr/sbin/sendmail'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 25
email.SMTPTimeout = 5
email.SMTPKeepAlive = false
email.SMTPCrypto = 'tls'
email.wordWrap = true
email.wrapChars = 76
email.mailType = 'text'
email.charset = 'UTF-8'
email.validate = false
email.priority = 3
email.CRLF = "\r\n"
email.newline = "\r\n"
email.BCCBatchMode = false
email.BCCBatchSize = 200
email.DSN = false